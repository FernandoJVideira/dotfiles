{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/ascii.txt",
    "color": {
      "1": "blue",
    },
    "padding": { "top": 1 },
  },
  "display": {
    "separator": "- ",

    "size": {
      "maxPrefix": "MB",
      "ndigits": 0,
    },
  },
  "modules": [
    "break",
    "break",
    "break",
    {
      // SkeinOS where it is installed, the distro's own name everywhere else (macOS included)
      "type": "command",
      "key": " OS  ",
      "keyColor": "red",
      "text": "if [ -x \"$HOME/.local/share/skein/libexec/skein-os-name\" ]; then \"$HOME/.local/share/skein/libexec/skein-os-name\"; elif [ -r /etc/os-release ]; then . /etc/os-release; echo \"$PRETTY_NAME $(uname -m)\"; else echo \"$(sw_vers -productName) $(sw_vers -productVersion) $(uname -m)\"; fi",
    },
    {
      "type": "kernel",
      "key": " VER ",
      "keyColor": "green",
    },
    {
      "type": "uptime",
      "key": "󰇄 UP  ",
      "keyColor": "yellow",
    },
    {
      "type": "packages",
      "key": "󰏗 PKG ",
      "keyColor": "blue",
    },
    {
      "type": "cpu",
      "key": " CPU ",
      "keyColor": "magenta",
    },
    {
      "type": "gpu",
      "key": "󰡀 GPU ",
    },
    {
      "type": "memory",
      "key": "󰍛 MEM ",
      "keyColor": "white",
      "format": "{/1}{-}{/}{/2}{-}{/}{} / {}",
    },
    {
      "type": "colors",
      "symbol": "circle",
    },
  ],
}
