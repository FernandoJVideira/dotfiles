<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.proton.pass.agent</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>exec /opt/homebrew/bin/pass-cli ssh-agent start --create-new-identities SSH --socket-path "$HOME/.ssh/proton-pass-agent.sock"</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>WorkingDirectory</key>
    <string>/Users/fvideira</string>

    <key>StandardOutPath</key>
    <string>/tmp/proton-agent.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/proton-agent.error.log</string>
</dict>
</plist>
