#!/usr/bin/env bash
# Switch the macOS theme the way `skeinctl theme set` does on Linux.
#   theme                 main menu: Theme, Wallpaper, Next wallpaper, Update themes
#   theme pick            pick a theme (fzf with a live preview; gum or select without it)
#   theme set <name>      apply a theme
#   theme list            all themes, the current one marked
#   theme current         name of the current theme
#   theme bg              pick a wallpaper of the current theme (fzf, with previews)
#   theme bg next         cycle to the theme's next wallpaper
#   theme update          pull the latest themes from the Skein fork
#   theme preview <name>  show a theme's palette (and its screenshot, in kitty/ghostty)
#
# The themes, the palette rules and the templates are Skein's own, so a theme looks
# the same here as on the Linux machines: this keeps a sparse clone of the fork in
# ~/.local/share/skein (themes + templates + the two scripts below, a few hundred KB;
# a theme's wallpapers are fetched the first time it is picked) and runs
# skein-theme-color / skein-theme-set-templates from it. Those need bash 4+, hence
# Homebrew's bash; this driver itself runs on the system bash 3.2.
#
# What happens on `theme set`, same order as skein-theme-set:
#   1. stage the theme in ~/.config/skein/current/next-theme and render every
#      template into it (default/themed/*.tpl plus ~/.config/skein/themed/*.tpl,
#      which is where macos/.config/skein/themed/ lands)
#   2. swap it in as ~/.config/skein/current/theme, record the name
#   3. wallpaper and the macOS light/dark appearance
#   4. reload the running terminals (kitty, ghostty) and btop
#   5. run ~/.config/skein/hooks/theme-set.d/* with the theme name
#      (starship, zed, neovim, sketchybar, borders, btop, and the macOS accent / folder
#      color: macos/.config/skein/hooks)
#
# THEME_SKIP="wallpaper,appearance,reload,hooks,accent,finder,spotify" skips those steps
# (used for testing; "finder" only skips restarting Finder and the Dock after a folder color
# change, "spotify" the restart of a running Spotify, and "signal" / "osc" only one of the two
# ways the terminals are recolored).
set -euo pipefail

REPO_URL="${SKEIN_REPO:-https://github.com/FernandoJVideira/skein.git}"
SKEIN_REF="${SKEIN_REF:-skein-nobara}"
export SKEIN_ROOT="${SKEIN_ROOT:-${XDG_DATA_HOME:-$HOME/.local/share}/skein}"
export SKEIN_CONFIG_HOME="${SKEIN_CONFIG_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/skein}"

THEMES_DIR="$SKEIN_ROOT/themes"
USER_THEMES_DIR="$SKEIN_CONFIG_HOME/themes"
USER_BACKGROUNDS_DIR="$SKEIN_CONFIG_HOME/backgrounds"
CURRENT_DIR="$SKEIN_CONFIG_HOME/current"
CURRENT_THEME_DIR="$CURRENT_DIR/theme"
NEXT_THEME_DIR="$CURRENT_DIR/next-theme"
THEME_NAME_FILE="$CURRENT_DIR/theme.name"
BACKGROUND_LINK="$CURRENT_DIR/background"
HOOKS_DIR="$SKEIN_CONFIG_HOME/hooks"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/skein"

die() { echo "theme: $*" >&2; exit 1; }
warn() { echo "theme: warning: $*" >&2; }
skipped() { [[ ,${THEME_SKIP:-}, == *",$1,"* ]]; }

# Skein's scripts start with `#!/usr/bin/env bash` and call each other, so
# Homebrew's bash has to win on PATH for all of them, not just the first.
BASH5=
for candidate in /opt/homebrew/bin/bash /usr/local/bin/bash; do
  [[ -x $candidate ]] && { BASH5=$candidate; break; }
done
[[ -n $BASH5 ]] || die "needs Homebrew's bash (brew install bash) to run Skein's scripts"
export PATH="$(dirname "$BASH5"):$PATH"

# A git run that gets killed (Ctrl-C, or fzf dropping a preview) leaves its lock files
# behind, and every later fetch then fails with "another git process seems to be
# running". With no git process alive they can only be stale.
clear_stale_git_locks() {
  local lock
  pgrep -x git >/dev/null 2>&1 && return 0
  for lock in index.lock config.lock shallow.lock info/sparse-checkout.lock; do
    [[ -f $SKEIN_ROOT/.git/$lock ]] && rm -f "$SKEIN_ROOT/.git/$lock"
  done
  return 0
}

# Only what rendering needs. Wallpapers and previews are the big files; a theme's wallpapers are added
# by fetch_backgrounds the first time it is applied.
set_sparse_checkout() {
  git -C "$SKEIN_ROOT" sparse-checkout set --no-cone \
    '/lib/common/' '/libexec/skein-theme-color' '/libexec/skein-theme-set-templates' \
    '/themes/' '/default/themed/' '!/themes/*/backgrounds/' '!/themes/*/preview.png'
}

# A machine that still has Omadora's directories: move them to Skein's names (the old path stays as a
# symlink), and move the sparse clone to the ref with the renamed files and redo its sparse patterns.
migrate_from_omadora() {
  local base old new
  for base in "${XDG_CONFIG_HOME:-$HOME/.config}" "${XDG_CACHE_HOME:-$HOME/.cache}" "${XDG_DATA_HOME:-$HOME/.local/share}"; do
    old="$base/omadora"
    new="$base/skein"
    if [[ -d $old && ! -L $old && ! -e $new ]]; then mv "$old" "$new" && ln -s "$new" "$old"; fi
  done
  [[ -d $SKEIN_ROOT/.git ]] || return 0
  git -C "$SKEIN_ROOT" remote set-url origin "$REPO_URL" 2>/dev/null || true
  if [[ ! -x $SKEIN_ROOT/libexec/skein-theme-color ]]; then
    echo "Moving the Skein themes to $SKEIN_REF..."
    git -C "$SKEIN_ROOT" fetch -q --depth 1 origin "$SKEIN_REF" &&
      git -C "$SKEIN_ROOT" checkout -q -B "$SKEIN_REF" FETCH_HEAD &&
      set_sparse_checkout || warn "couldn't move $SKEIN_ROOT to $SKEIN_REF (offline?)"
  fi
  return 0
}

ensure_repo() {
  migrate_from_omadora
  if [[ -d $SKEIN_ROOT/.git ]]; then
    clear_stale_git_locks
    return 0
  fi
  [[ ! -e $SKEIN_ROOT ]] || die "$SKEIN_ROOT exists but is not a git checkout"
  command -v git >/dev/null || die "git is required"
  echo "Fetching the Skein themes (sparse clone, no wallpapers yet)..."
  git clone -q --depth 1 --filter=blob:none --sparse --branch "$SKEIN_REF" "$REPO_URL" "$SKEIN_ROOT" ||
    die "couldn't clone $REPO_URL ($SKEIN_REF)"
  set_sparse_checkout || die "couldn't set up the sparse checkout"
}

# The menu shows every theme's screenshot, and fzf may kill a preview at any moment, so
# the ~14 MB of them are fetched once, here, instead of one by one inside the preview
# (a kill in the middle of a git run is what leaves lock files behind).
fetch_all_previews() {
  git -C "$SKEIN_ROOT" sparse-checkout list 2>/dev/null | grep -qxF '/themes/*/preview.png' && return 0
  echo "Fetching the theme previews (once, ~14 MB)..."
  git -C "$SKEIN_ROOT" sparse-checkout add '/themes/*/preview.png' >/dev/null 2>&1 ||
    warn "couldn't fetch the theme previews (offline?) - the menu will show palettes only"
  return 0
}

normalize() {
  printf '%s' "$1" | sed -E 's/<[^>]+>//g' | tr '[:upper:] ' '[:lower:]-'
}

list_themes() {
  {
    [[ -d $USER_THEMES_DIR ]] && find "$USER_THEMES_DIR" -mindepth 1 -maxdepth 1 -type d -exec basename {} \;
    [[ -d $THEMES_DIR ]] && find "$THEMES_DIR" -mindepth 1 -maxdepth 1 -type d -exec basename {} \;
    true
  } | sort -u
}

current_theme() {
  [[ -s $THEME_NAME_FILE ]] && head -n 1 "$THEME_NAME_FILE"
  return 0
}

fetch_backgrounds() {
  local name=$1
  [[ -d $THEMES_DIR/$name ]] || return 0
  [[ -d $THEMES_DIR/$name/backgrounds ]] && return 0
  git -C "$SKEIN_ROOT" sparse-checkout add "/themes/$name/backgrounds/" >/dev/null 2>&1 ||
    warn "couldn't fetch the wallpapers for $name (offline?)"
}

# Next wallpaper after the current one, wrapping; the first one when the current
# wallpaper belongs to another theme. Prints nothing if the theme has none.
next_background() {
  local name=$1 file current= count=0 i next= found=-1
  local files=()
  current=$(readlink "$BACKGROUND_LINK" 2>/dev/null || true)
  while IFS= read -r file; do
    [[ -n $file ]] || continue
    files[count]=$file
    count=$((count + 1))
  done < <(find -L "$USER_BACKGROUNDS_DIR/$name" "$CURRENT_THEME_DIR/backgrounds" \
    -maxdepth 1 -type f ! -name '.*' 2>/dev/null | sort)
  ((count > 0)) || return 0
  for ((i = 0; i < count; i++)); do
    [[ ${files[i]} == "$current" ]] && { found=$i; break; }
  done
  if ((found < 0)); then next=${files[0]}; else next=${files[(found + 1) % count]}; fi
  printf '%s' "$next"
}

set_wallpaper() {
  local file=$1 name=$2 jpg
  # Desktop pictures are happiest with JPEG/PNG/HEIC; the themes also ship WebP.
  case "$file" in
    *.webp | *.WEBP | *.avif)
      mkdir -p "$CACHE_DIR/backgrounds"
      jpg="$CACHE_DIR/backgrounds/$name-$(basename "${file%.*}").jpg"
      [[ -f $jpg ]] || sips -s format jpeg "$file" --out "$jpg" >/dev/null 2>&1 || {
        warn "couldn't convert $file for the desktop"
        return 1
      }
      file=$jpg
      ;;
  esac
  osascript \
    -e 'on run argv' \
    -e 'tell application "System Events" to tell every desktop to set picture to POSIX file (item 1 of argv)' \
    -e 'end run' "$file" >/dev/null
}

apply_background() {
  local name=$1 file
  file=$(next_background "$name")
  if [[ -z $file ]]; then
    rm -f "$BACKGROUND_LINK"
    echo "No wallpapers available for $name."
    return 0
  fi
  use_background "$name" "$file"
}

apply_appearance() {
  local mode dark=true
  mode=$("$BASH5" "$SKEIN_ROOT/libexec/skein-theme-color" --file "$CURRENT_THEME_DIR/colors.toml" mode 2>/dev/null || echo dark)
  [[ $mode == light ]] && dark=false
  osascript -e "tell application \"System Events\" to tell appearance preferences to set dark mode to $dark" >/dev/null 2>&1 ||
    warn "couldn't switch the macOS appearance to $mode (System Events needs Automation permission for this terminal)"
}

# Terminal colors, pushed straight into every terminal on the machine (kitty, ghostty,
# Terminal.app...), the way pywal does: the palette, foreground, background, cursor and
# selection colors of the rendered kitty.conf as OSC escape sequences, written to each tty
# device. Signalling the terminals to reload their config does the same job, but only if
# the signal lands; this doesn't depend on it, and a config reload that comes after sets
# the very same colors.
push_terminal_colors() {
  local conf="$CURRENT_THEME_DIR/kitty.conf" seq= key val n tty
  [[ -f $conf ]] || return 0
  while read -r key val; do
    [[ $val =~ ^#[0-9a-fA-F]{6}$ ]] || continue
    case "$key" in
      foreground) seq+=$(printf '\033]10;%s\033\\' "$val") ;;
      background) seq+=$(printf '\033]11;%s\033\\' "$val") ;;
      cursor) seq+=$(printf '\033]12;%s\033\\' "$val") ;;
      selection_background) seq+=$(printf '\033]17;%s\033\\' "$val") ;;
      selection_foreground) seq+=$(printf '\033]19;%s\033\\' "$val") ;;
      color[0-9] | color1[0-5])
        n=${key#color}
        seq+=$(printf '\033]4;%s;%s\033\\' "$n" "$val")
        ;;
    esac
  done <"$conf"
  [[ -n $seq ]] || return 0
  # Only devices that are mine: macOS also has world-writable, root-owned legacy ptys
  # (/dev/ttys0-9) that nothing ever opened, and writing to those blocks forever.
  # THEME_TTYS: space-separated device list instead of all of them (for testing).
  local pids=() alive i p
  for tty in ${THEME_TTYS:-/dev/ttys[0-9]*}; do
    [[ -O $tty && -w $tty ]] || continue
    ( printf '%s' "$seq" >"$tty" ) 2>/dev/null &
    pids[${#pids[@]}]=$!
  done
  # a terminal that doesn't read (stopped, wedged) must not stall a theme switch: 2s at most
  for ((i = 0; i < 20; i++)); do
    alive=0
    for p in ${pids[@]+"${pids[@]}"}; do kill -0 "$p" 2>/dev/null && alive=1; done
    ((alive)) || break
    sleep 0.1
  done
  for p in ${pids[@]+"${pids[@]}"}; do kill -9 "$p" 2>/dev/null || true; done
  wait 2>/dev/null || true
  return 0
}

reload_app() {
  local signal=$1 app=$2
  pgrep -x "$app" >/dev/null 2>&1 && pkill -"$signal" -x "$app" 2>/dev/null || true
}

run_hooks() {
  local name=$1 hook
  if [[ -f $HOOKS_DIR/theme-set ]]; then
    "$BASH5" "$HOOKS_DIR/theme-set" "$name" || warn "hook failed: $HOOKS_DIR/theme-set"
  fi
  [[ -d $HOOKS_DIR/theme-set.d ]] || return 0
  for hook in "$HOOKS_DIR"/theme-set.d/*; do
    [[ -f $hook && $hook != *.sample ]] || continue
    "$BASH5" "$hook" "$name" || warn "hook failed: $hook"
  done
}

set_theme() {
  local name
  name=$(normalize "$1")
  [[ -n $name && $name != .* && $name != */* ]] || die "invalid theme name: $1"
  ensure_repo
  [[ -d $THEMES_DIR/$name || -d $USER_THEMES_DIR/$name ]] || die "unknown theme: $name (try: theme list)"

  echo "Applying theme: $name"
  skipped wallpaper || fetch_backgrounds "$name"

  mkdir -p "$CURRENT_DIR"
  rm -rf "$NEXT_THEME_DIR"
  mkdir -p "$NEXT_THEME_DIR"
  [[ -d $THEMES_DIR/$name ]] && cp -R "$THEMES_DIR/$name/." "$NEXT_THEME_DIR/"
  [[ -d $USER_THEMES_DIR/$name ]] && cp -R "$USER_THEMES_DIR/$name/." "$NEXT_THEME_DIR/"
  [[ -f $NEXT_THEME_DIR/colors.toml ]] || die "theme $name has no colors.toml"

  "$BASH5" "$SKEIN_ROOT/libexec/skein-theme-set-templates" || {
    rm -rf "$NEXT_THEME_DIR"
    die "failed to render the themed templates for $name"
  }

  rm -rf "$CURRENT_THEME_DIR"
  mv "$NEXT_THEME_DIR" "$CURRENT_THEME_DIR"
  printf '%s\n' "$name" >"$THEME_NAME_FILE"

  skipped wallpaper || apply_background "$name"
  skipped appearance || apply_appearance
  if ! skipped reload; then
    skipped signal || { reload_app USR1 kitty; reload_app USR2 ghostty; }
    skipped osc || push_terminal_colors
  fi
  skipped hooks || run_hooks "$name"
  skipped reload || reload_app USR2 btop

  echo "Theme applied: $name"
}

# Lines of text the preview prints above the screenshot; the image is placed below them.
PREVIEW_TEXT_LINES=9

# Can this terminal draw images with the kitty graphics protocol (kitty, ghostty; tmux
# passes it through, and kitten icat detects tmux by itself)?
can_draw_images() {
  command -v kitten >/dev/null 2>&1 &&
    [[ -n ${KITTY_WINDOW_ID:-}${GHOSTTY_RESOURCES_DIR:-} || ${TERM_PROGRAM:-} == ghostty ]]
}

# Draw an image under the text a preview already printed ($2 lines of it).
draw_image() {
  local img=$1 used=$2 h
  can_draw_images || return 0
  if [[ -n ${FZF_PREVIEW_COLUMNS:-} ]]; then
    # Inside fzf's preview pane, fzf's own recipe (see fzf-preview.sh in its repo): icat
    # prints the image as unicode placeholder characters, i.e. as text, which fzf lays
    # out like the text above it. No cursor positioning, and nothing is left on screen
    # when the next preview replaces this one.
    h=$((FZF_PREVIEW_LINES - used - 1))
    if ((h > 3)); then
      kitten icat --clear --transfer-mode=memory --unicode-placeholder --stdin=no \
        --place="${FZF_PREVIEW_COLUMNS}x${h}@0x0" "$img" 2>/dev/null | sed '$d' || true
      # the last line icat prints is an ANSI reset without a newline, which confuses fzf
      printf '\033[m'
    fi
  else
    printf '\n'
    kitten icat --stdin=no --transfer-mode=memory "$img" 2>/dev/null || true
  fi
  return 0
}

# 24-bit color helpers for the preview: "#rrggbb" -> "r;g;b"
rgb() { local h=${1#\#}; printf '%d;%d;%d' "0x${h:0:2}" "0x${h:2:2}" "0x${h:4:2}"; }

# Show a theme: its palette rendered in the terminal's own colors, then its
# preview.png (what the Linux menu shows) where the terminal can draw images.
preview() {
  local name=$1 file pal mode k v img h
  ensure_repo
  file="$USER_THEMES_DIR/$name/colors.toml"
  [[ -f $file ]] || file="$THEMES_DIR/$name/colors.toml"
  [[ -f $file ]] || die "unknown theme: $name"
  pal=$("$BASH5" "$SKEIN_ROOT/libexec/skein-theme-color" --file "$file" --all) || die "couldn't read the palette of $name"
  c() { printf '%s\n' "$pal" | awk -F'\t' -v k="$1" '$1==k{print $2}'; }
  mode=$(c mode)

  local bg fg
  bg=$(rgb "$(c background)"); fg=$(rgb "$(c foreground)")
  printf ' \033[1m%s\033[0m  (%s)\n\n' "$name" "$mode"
  printf ' \033[48;2;%sm\033[38;2;%sm %-34s \033[0m\n' "$bg" "$fg" ""
  printf ' \033[48;2;%sm\033[38;2;%sm %s \033[38;2;%sm%s \033[38;2;%sm%s \033[38;2;%sm%s \033[0m\n' "$bg" "$fg" \
    "The quick" "$(rgb "$(c accent)")" "accent" "$(rgb "$(c green)")" "ok" "$(rgb "$(c red)")" "error  "
  printf ' \033[48;2;%sm\033[38;2;%sm %-34s \033[0m\n\n' "$bg" "$fg" ""
  for row in "red green yellow blue magenta cyan orange accent" "bright_red bright_green bright_yellow bright_blue bright_magenta bright_cyan brown muted"; do
    printf ' '
    for k in $row; do
      v=$(c "$k"); [[ -n $v ]] || v=$(c foreground)
      printf '\033[48;2;%sm    \033[0m ' "$(rgb "$v")"
    done
    printf '\n'
  done

  # The screenshot is one ~0.5 MB file per theme: fetched the first time it's shown.
  img="$USER_THEMES_DIR/$name/preview.png"
  if [[ ! -f $img ]]; then
    img="$THEMES_DIR/$name/preview.png"
    [[ -f $img || ! -d $THEMES_DIR/$name || -n ${THEME_NO_FETCH:-} ]] ||
      git -C "$SKEIN_ROOT" sparse-checkout add "/themes/$name/preview.png" >/dev/null 2>&1 || true
  fi
  [[ -f $img ]] || return 0
  draw_image "$img" "$PREVIEW_TEXT_LINES"
  return 0
}

# All wallpapers of a theme: the checkout's (copied into the current theme dir) plus the
# user's own in ~/.config/skein/backgrounds/<theme>.
list_backgrounds() {
  local name=$1
  # find exits non-zero when the user's directory doesn't exist, which pipefail would
  # turn into a failure of every pipeline this list feeds
  { find -L "$USER_BACKGROUNDS_DIR/$name" "$CURRENT_THEME_DIR/backgrounds" \
    -maxdepth 1 -type f ! -name '.*' 2>/dev/null || true; } | sort
}

# Fetch the theme's wallpapers if needed and refresh the copy in the current theme dir.
prepare_backgrounds() {
  local name=$1
  fetch_backgrounds "$name"
  if [[ -d $THEMES_DIR/$name/backgrounds ]]; then
    rm -rf "$CURRENT_THEME_DIR/backgrounds"
    cp -R "$THEMES_DIR/$name/backgrounds" "$CURRENT_THEME_DIR/backgrounds"
  fi
}

# Wallpapers are 1-4 MB each: the picker previews small JPEG thumbnails, made once up
# front (not inside fzf's preview, which fzf may kill at any moment).
thumb_path() { printf '%s/thumbs/%s-%s.jpg' "$CACHE_DIR" "$1" "$(basename "${2%.*}")"; }

make_thumb() {
  local name=$1 file=$2 thumb tmp
  thumb=$(thumb_path "$name" "$file")
  [[ -s $thumb ]] && return 0
  mkdir -p "$CACHE_DIR/thumbs"
  tmp="$thumb.tmp"
  if sips -s format jpeg -Z 1000 "$file" --out "$tmp" >/dev/null 2>&1; then mv -f "$tmp" "$thumb"; else rm -f "$tmp"; fi
  return 0
}

make_thumbs() {
  local name=$1 file
  while IFS= read -r file; do make_thumb "$name" "$file"; done < <(list_backgrounds "$name")
}

# Preview of one wallpaper inside the picker: file name, size, then the thumbnail.
bg_preview() {
  local file=$1 name thumb dims
  name=$(current_theme)
  dims=$(sips -g pixelWidth -g pixelHeight "$file" 2>/dev/null | awk '/pixelWidth/{w=$2} /pixelHeight/{h=$2} END{if (w) print w " x " h}')
  printf ' \033[1m%s\033[0m\n %s\n\n' "$(basename "$file")" "${dims:-unknown size}"
  thumb=$(thumb_path "$name" "$file")
  [[ -s $thumb ]] && draw_image "$thumb" 3
  return 0
}

# Make this wallpaper the desktop picture and remember it, so `theme bg next` goes on from it.
use_background() {
  local name=$1 file=$2
  ln -sfn "$file" "$BACKGROUND_LINK"
  skipped wallpaper && return 0
  set_wallpaper "$file" "$name" || warn "couldn't set the wallpaper (System Events needs Automation permission for this terminal)"
}

bg_menu() {
  local name current self index choice
  name=$(current_theme)
  [[ -n $name ]] || die "no theme set yet"
  ensure_repo
  prepare_backgrounds "$name"
  if [[ -z $(list_backgrounds "$name") ]]; then
    echo "No wallpapers available for $name."
    return 0
  fi
  if ! command -v fzf >/dev/null 2>&1 || ! [[ -t 0 && -t 1 ]]; then
    apply_background "$name"   # no picker here: just the next one
    return 0
  fi
  make_thumbs "$name"
  current=$(readlink "$BACKGROUND_LINK" 2>/dev/null || true)
  self=$(printf '%q' "$0")
  index=$(list_backgrounds "$name" | grep -n -x -F -- "${current:-}" | head -n 1 | cut -d: -f1 || true)
  choice=$(list_backgrounds "$name" | fzf --prompt 'Wallpaper > ' --header "theme: $name" \
    --delimiter / --with-nth -1 \
    --preview "$self bg-preview {}" --preview-window 'right,65%,border-left' \
    --bind "load:pos(${index:-1})+unbind(load)" --no-multi) || return 0
  [[ -n $choice ]] || return 0
  use_background "$name" "$choice"
  echo "Wallpaper: $(basename "$choice")"
}

theme_menu() {
  local current choice index self
  current=$(current_theme)
  ensure_repo
  if command -v fzf >/dev/null 2>&1 && [[ -t 0 && -t 1 ]]; then
    # fzf rather than gum: it can show a preview pane next to the list
    fetch_all_previews
    self=$(printf '%q' "$0")
    index=$(list_themes | grep -n -x -F -- "${current:-}" | head -n 1 | cut -d: -f1 || true)
    choice=$(list_themes | fzf --prompt 'Theme > ' --header "current: ${current:-none}" \
      --preview "$self preview {}" --preview-window 'right,60%,border-left' \
      --bind "load:pos(${index:-1})+unbind(load)" --no-multi) || exit 0
  elif command -v gum >/dev/null 2>&1 && [[ -t 0 && -t 1 ]]; then
    choice=$(list_themes | gum choose --header "Theme (current: ${current:-none})" \
      ${current:+--selected="$current"} --height 15) || exit 0
  else
    local themes=()
    while IFS= read -r t; do themes[${#themes[@]}]=$t; done < <(list_themes)
    PS3="Theme: "
    select choice in "${themes[@]}"; do [[ -n $choice ]] && break; done
  fi
  [[ -n $choice ]] || exit 0
  set_theme "$choice"
}


MAIN_ITEMS="Theme
Wallpaper
Next wallpaper
Update themes"

# What each entry of the main menu would do, shown next to the list.
main_preview() {
  local item=$1 current file
  current=$(current_theme)
  case "$item" in
    Theme)
      printf ' \033[1mPick a theme\033[0m\n Current: %s\n\n' "${current:-none}"
      [[ -n $current ]] && THEME_NO_FETCH=1 preview "$current"
      ;;
    Wallpaper)
      printf ' \033[1mPick a wallpaper\033[0m\n Of the current theme (%s)\n\n' "${current:-none}"
      file=$(readlink "$BACKGROUND_LINK" 2>/dev/null || true)
      if [[ -n $file && -f $file ]]; then
        printf ' Now:\n'
        bg_preview "$file"
      fi
      ;;
    "Next wallpaper")
      printf ' \033[1mNext wallpaper\033[0m\n Cycle to the next wallpaper of %s\n' "${current:-the current theme}"
      ;;
    "Update themes")
      printf ' \033[1mUpdate themes\033[0m\n Pull the latest themes, palettes and templates\n from the Skein fork.\n'
      ;;
  esac
  return 0
}

main_menu() {
  local current choice self file
  current=$(current_theme)
  if ! { command -v fzf >/dev/null 2>&1 && [[ -t 0 && -t 1 ]]; }; then
    theme_menu   # no fzf or no terminal: straight to the theme list
    return
  fi
  ensure_repo
  # the current wallpaper's thumbnail for the preview, made here and not inside fzf
  file=$(readlink "$BACKGROUND_LINK" 2>/dev/null || true)
  [[ -n $current && -n $file && -f $file ]] && make_thumb "$current" "$file"
  self=$(printf '%q' "$0")
  choice=$(printf '%s\n' "$MAIN_ITEMS" | fzf --prompt 'theme > ' --header "current: ${current:-none}" \
    --preview "$self main-preview {}" --preview-window 'right,60%,border-left' \
    --no-multi) || exit 0
  case "$choice" in
    Theme) theme_menu ;;
    Wallpaper) bg_menu ;;
    "Next wallpaper")
      [[ -n $current ]] || die "no theme set yet"
      prepare_backgrounds "$current"
      apply_background "$current"
      ;;
    "Update themes") git -C "$SKEIN_ROOT" pull -q --ff-only && echo "Themes updated." ;;
  esac
}

case "${1:-}" in
  "") main_menu ;;
  pick) theme_menu ;;
  set)
    [[ $# -eq 2 ]] || die "usage: theme set <name>"
    set_theme "$2"
    ;;
  list)
    ensure_repo
    current=$(current_theme)
    list_themes | while IFS= read -r t; do
      if [[ $t == "$current" ]]; then echo "* $t"; else echo "  $t"; fi
    done
    ;;
  current)
    current=$(current_theme)
    [[ -n $current ]] && echo "$current"
    ;;
  bg)
    case "${2:-}" in
      "") bg_menu ;;
      next)
        current=$(current_theme)
        [[ -n $current ]] || die "no theme set yet"
        ensure_repo
        prepare_backgrounds "$current"
        apply_background "$current"
        ;;
      *) die "usage: theme bg [next]" ;;
    esac
    ;;
  main-preview)
    [[ $# -eq 2 ]] || exit 1
    main_preview "$2"
    ;;
  bg-preview)
    [[ $# -eq 2 ]] || exit 1
    bg_preview "$2"
    ;;
  preview)
    [[ $# -eq 2 ]] || die "usage: theme preview <name>"
    preview "$(normalize "$2")"
    ;;
  update)
    ensure_repo
    git -C "$SKEIN_ROOT" pull -q --ff-only && echo "Themes updated."
    ;;
  -h | --help | help)
    sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'
    ;;
  *)
    # `theme gruvbox` as shorthand for `theme set gruvbox`
    set_theme "$1"
    ;;
esac
