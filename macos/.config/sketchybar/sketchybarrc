#!/usr/bin/env bash

# A flat bar after Skein's (config/quickshell/skein in the fork): the theme's background, icon-only
# modules whose value shows while the pointer is over them (Skein's tooltips), workspaces as numbers
# with a dot for the one in use, and Skein's panels as popups (menu, calendar, battery, Wi-Fi, CPU,
# volume). The middle is left empty, since that is where the notch is; the clock is at the right edge,
# in the short form macOS uses.
# The classic bar (compartments, always-on labels) is tagged backup/sketchybar-2026-10-28.

CONFIG_DIR="$HOME/.config/sketchybar"
PLUGIN_DIR="$CONFIG_DIR/plugins"

# === COLORS ===
# Rendered from the current theme by the `theme` command (macos/.config/skein/themed/
# macos-colors.sh.tpl); Gruvbox Dark values until the first theme is set.
COLORS_FILE="$HOME/.config/skein/current/theme/macos-colors.sh"
if [[ -f $COLORS_FILE ]]; then
  # shellcheck source=/dev/null
  source "$COLORS_FILE"
fi
CLR_BAR_BG="${CLR_BAR_BG:-0xff282828}"
CLR_FG="${CLR_FG:-0xffebdbb2}"
CLR_FG_DIM="${CLR_FG_DIM:-0x77ebdbb2}"
CLR_ACCENT="${CLR_ACCENT:-0xfffe8019}"
CLR_ALERT="${CLR_ALERT:-0xffa55555}"

# === SIZES (a little bigger than Skein's, which is 26px with 8px module padding and 10.5pt text) ===
BAR_HEIGHT=40
MODULE_PADDING=10
SECTION_PADDING=8
ICON_FONT="JetBrainsMono Nerd Font:Regular:17.0"
LABEL_FONT="SF Pro:Medium:14.0"
PANEL_FONT="JetBrainsMono Nerd Font:Regular:14.0"

# === THE NOTCH ===
# A notch display reports a safe area at the top (the height of the notch, which is also the height of
# its menu bar) and the two usable areas beside the notch; the notch is what is left between them.
# Without a notch both come back 0, and the bar keeps its own height everywhere.
read -r NOTCH_HEIGHT NOTCH_WIDTH < <(osascript -l JavaScript -e '
  ObjC.import("AppKit");
  let out = "0 0";
  const screens = $.NSScreen.screens;
  for (let i = 0; i < screens.count; i++) {
    const s = screens.objectAtIndex(i);
    if (s.safeAreaInsets.top > 0) {
      out = Math.round(s.safeAreaInsets.top) + " " + Math.round(s.frame.size.width - s.auxiliaryTopLeftArea.size.width - s.auxiliaryTopRightArea.size.width);
      break;
    }
  }
  out' 2>/dev/null || echo "0 0")
NOTCH_HEIGHT="${NOTCH_HEIGHT:-0}"
NOTCH_WIDTH="${NOTCH_WIDTH:-0}"

# === BAR ===
BAR_ARGS=(position=top height="$BAR_HEIGHT" color="$CLR_BAR_BG" blur_radius=0 corner_radius=0 border_width=0 shadow=off
  padding_left="$SECTION_PADDING" padding_right="$SECTION_PADDING" y_offset=0)
if ((NOTCH_HEIGHT > 0)); then
  # the notch display's bar is at least as tall as the notch (its menu bar), and as the bar itself
  ((NOTCH_HEIGHT < BAR_HEIGHT)) && NOTCH_HEIGHT="$BAR_HEIGHT"
  BAR_ARGS+=(notch_display_height="$NOTCH_HEIGHT" notch_width="$NOTCH_WIDTH")
fi
sketchybar --bar "${BAR_ARGS[@]}"

# === DEFAULTS (must precede item creation below; --default only applies to items created after it) ===
# Icon-only: a label is drawn only while the pointer is over its item (plugins/lib.sh).
sketchybar --default \
  padding_left=0 \
  padding_right=0 \
  icon.font="$ICON_FONT" \
  label.font="$LABEL_FONT" \
  icon.color="$CLR_FG" \
  label.color="$CLR_FG" \
  icon.padding_left="$MODULE_PADDING" \
  icon.padding_right="$MODULE_PADDING" \
  label.padding_left=0 \
  label.padding_right="$MODULE_PADDING" \
  label.drawing=off

# === POPUPS (Skein's panels and menu) ===
# Shared look: the bar's color with a hairline border and rounded corners. They close when the pointer
# leaves them (plugins/lib.sh).
POPUP_STYLE=(
  popup.horizontal=off
  popup.height=38
  popup.y_offset=6
  popup.background.color="$CLR_BAR_BG"
  popup.background.corner_radius=18
  popup.background.border_width=1
  popup.background.border_color="${CLR_COMP_BORDER:-$CLR_FG_DIM}"
  popup.background.shadow.drawing=on
)
# one entry of a menu popup: popup_entry <parent> <name> <glyph> <label> <command>
popup_entry() {
  sketchybar --add item "$2" "popup.$1" \
    --set "$2" icon="$3" label="$4" label.drawing=on \
    icon.padding_left=18 icon.padding_right=12 label.padding_right=26 \
    icon.width=50 icon.align=center \
    click_script="sketchybar --set $1 popup.drawing=off; $5"
}

# the lines of a panel (battery, Wi-Fi, CPU), filled in by plugins/panel.sh when it opens
panel_rows() {
  local row
  for row in 1 2 3 4 5 6; do
    sketchybar --add item "$1.i$row" "popup.$1" \
      --set "$1.i$row" label.drawing=on label.font="$PANEL_FONT" label.width=300 label.align=left \
      label.padding_left=22 label.padding_right=22 drawing=off \
      click_script="sketchybar --set $1 popup.drawing=off"
  done
}

# === LEFT: the Skein glyph, workspaces, front app ===
# The glyph is Skein's menu: the theme, the wallpaper and the power entries (Skein's skein-menu).
sketchybar --add item skein left \
  --set skein \
    icon="" \
    icon.color="$CLR_ACCENT" \
    icon.padding_left="$MODULE_PADDING" \
    icon.padding_right="$MODULE_PADDING" \
    "${POPUP_STYLE[@]}" \
    popup.align=left \
    script="$PLUGIN_DIR/popup.sh" \
    click_script="sketchybar --set skein popup.drawing=toggle" \
  --subscribe skein mouse.exited.global
popup_entry skein skein.theme "󰏘" "Theme" "open -g hammerspoon://theme"
popup_entry skein skein.wallpaper "󰋩" "Next wallpaper" "theme bg next"
popup_entry skein skein.update "󰚰" "Update themes" "theme update && osascript -e 'display notification \"Themes updated\" with title \"Skein\"'"
popup_entry skein skein.lock "󰌾" "Lock screen" "pmset displaysleepnow"
popup_entry skein skein.sleep "󰒲" "Sleep" "pmset sleepnow"
popup_entry skein skein.restart "󰜉" "Restart…" "osascript -e 'display dialog \"Restart now?\" buttons {\"Cancel\", \"Restart\"} default button \"Cancel\" with icon caution' -e 'tell application \"System Events\" to restart'"
popup_entry skein skein.shutdown "󰐥" "Shut down…" "osascript -e 'display dialog \"Shut down now?\" buttons {\"Cancel\", \"Shut Down\"} default button \"Cancel\" with icon caution' -e 'tell application \"System Events\" to shut down'"

# Workspaces 1-5 always, 6-10 only while they have windows; the one in use shows a dot. Which is which
# is decided for all of them at once by plugins/spaces.sh.
sketchybar --add event hyprspace_workspace_change
for sid in $(seq 1 10); do
  number="$sid"
  ((sid == 10)) && number=0
  sketchybar --add item "space.$sid" left \
    --set "space.$sid" \
      icon="󱓻" \
      icon.drawing=off \
      icon.color="$CLR_ACCENT" \
      icon.padding_left="$MODULE_PADDING" \
      icon.padding_right="$MODULE_PADDING" \
      label="$number" \
      label.drawing=on \
      label.color="$CLR_FG_DIM" \
      label.padding_left="$MODULE_PADDING" \
      label.padding_right="$MODULE_PADDING" \
      click_script="hyprspace workspace $sid"
done
sketchybar --add item spaces_ctl left \
  --set spaces_ctl drawing=off updates=on update_freq=2 script="$PLUGIN_DIR/spaces.sh" \
  --subscribe spaces_ctl hyprspace_workspace_change

sketchybar --add item front_app left \
  --set front_app \
    script="$PLUGIN_DIR/front_app.sh" \
    icon.drawing=off \
    label.drawing=on \
    label.color="$CLR_FG_DIM" \
    label.padding_left=4 \
  --subscribe front_app front_app_switched

# === RIGHT, from the edge inwards: clock, battery, CPU, volume, Wi-Fi, stay awake ===
# The clock is short, like macOS's ("Wed 28 Oct  18:45"); click opens the calendar panel.
sketchybar --add item clock right \
  --set clock update_freq=10 script="$PLUGIN_DIR/clock.sh" label.drawing=on \
    label.padding_left="$MODULE_PADDING" label.padding_right=14 \
    "${POPUP_STYLE[@]}" popup.align=right \
    click_script="$PLUGIN_DIR/calendar.sh toggle" \
  --subscribe clock mouse.exited.global

# The calendar panel: a month in a monospaced grid, filled in by plugins/calendar.sh when it opens.
for row in title head w1 w2 w3 w4 w5 w6; do
  sketchybar --add item "cal.$row" popup.clock \
    --set "cal.$row" label.drawing=on label.font="$PANEL_FONT" label.width=310 label.align=center \
      label.padding_left=16 label.padding_right=16 click_script="sketchybar --set clock popup.drawing=off"
done
sketchybar --set cal.title label.font="JetBrainsMono Nerd Font:Bold:15.0" label.color="$CLR_ACCENT" \
  --set cal.head label.color="$CLR_FG_DIM"

sketchybar --add item battery right \
  --set battery update_freq=120 script="$PLUGIN_DIR/battery.sh" \
    "${POPUP_STYLE[@]}" popup.align=right \
    click_script="$PLUGIN_DIR/panel.sh battery toggle" \
  --subscribe battery system_woke power_source_change mouse.entered mouse.exited mouse.exited.global
panel_rows battery
popup_entry battery battery.settings "󰒓" "Battery settings…" "open 'x-apple.systempreferences:com.apple.Battery-Settings.extension'"

sketchybar --add item cpu_load right \
  --set cpu_load icon="󰍛" update_freq=5 script="$PLUGIN_DIR/cpu_load.sh" \
    "${POPUP_STYLE[@]}" popup.align=right \
    click_script="$PLUGIN_DIR/panel.sh cpu_load toggle" \
  --subscribe cpu_load mouse.entered mouse.exited mouse.exited.global
panel_rows cpu_load
popup_entry cpu_load cpu_load.monitor "󰍛" "Activity Monitor…" "open -a 'Activity Monitor'"

sketchybar --add item volume right \
  --set volume update_freq=30 script="$PLUGIN_DIR/volume.sh" \
    "${POPUP_STYLE[@]}" popup.align=right \
    click_script="sketchybar --set volume popup.drawing=toggle" \
  --subscribe volume volume_change mouse.entered mouse.exited mouse.exited.global
# The audio panel: a slider for the output volume and a way into the sound settings.
sketchybar --add slider volume.slider popup.volume 160 \
  --set volume.slider \
    icon.drawing=off label.drawing=off \
    padding_left=20 padding_right=20 \
    slider.highlight_color="$CLR_ACCENT" \
    slider.background.height=6 slider.background.corner_radius=3 \
    slider.background.color="$CLR_FG_DIM" \
    slider.knob="●" slider.knob.drawing=on \
    script="$PLUGIN_DIR/volume_slider.sh" \
  --subscribe volume.slider mouse.clicked
popup_entry volume volume.settings "󰒓" "Sound settings…" "open 'x-apple.systempreferences:com.apple.Sound-Settings.extension'"

sketchybar --add item net right \
  --set net update_freq=20 script="$PLUGIN_DIR/wifi.sh" \
    "${POPUP_STYLE[@]}" popup.align=right \
    click_script="$PLUGIN_DIR/panel.sh net toggle" \
  --subscribe net wifi_change mouse.entered mouse.exited mouse.exited.global
panel_rows net
popup_entry net net.power "󰐥" "Turn Wi-Fi off" "$PLUGIN_DIR/wifi_power.sh"
popup_entry net net.settings "󰒓" "Wi-Fi settings…" "open 'x-apple.systempreferences:com.apple.wifi-settings-extension'"

# Stay awake (caffeinate), like Skein's indicator: dim while off, the accent color while on.
sketchybar --add item awake right \
  --set awake icon="󰅶" icon.color="$CLR_FG_DIM" update_freq=5 \
    script="$PLUGIN_DIR/awake.sh" click_script="$PLUGIN_DIR/awake.sh toggle"

# === FINALIZE ===
# Small delay so item event subscriptions are registered before the initial sync fires
(sleep 0.2 && sketchybar --trigger hyprspace_workspace_change FOCUSED_WORKSPACE="$(hyprspace list-workspaces --focused)") &
sketchybar --update
