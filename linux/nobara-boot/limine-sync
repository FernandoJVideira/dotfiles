#!/usr/bin/env bash
# Regenerate /boot/limine/limine.conf from the Boot Loader Spec entries that kernel-install
# maintains in /boot/loader/entries (newest kernel first, rescue entry last).
# BOOT=/some/mountpoint overrides the boot partition (used while staging a new /boot).
# Installed to /usr/local/libexec/limine-sync by limine-migrate.sh and run by the
# kernel-install plugin /etc/kernel/install.d/95-limine.install on every kernel add/remove.
set -euo pipefail

BOOT=${BOOT:-/boot}
ENTRIES=$BOOT/loader/entries
OUT=$BOOT/limine/limine.conf
TIMEOUT=${LIMINE_TIMEOUT:-5}
THEME_FILE=${LIMINE_THEME:-/usr/local/share/limine-sync/theme.conf}

[[ -d $ENTRIES ]] || { echo "limine-sync: $ENTRIES not found" >&2; exit 1; }

# Path as Limine sees it: relative to the volume that holds the config (the /boot partition).
vol_path() {
  local p=$1
  if mountpoint -q "$BOOT"; then
    [[ -e $BOOT$p ]] && { printf 'boot():%s' "$p"; return; }
    # entries written for a /boot that is not its own partition
    [[ $p == /boot/* && -e $BOOT${p#/boot} ]] && { printf 'boot():%s' "${p#/boot}"; return; }
  fi
  echo "limine-sync: $p does not exist under $BOOT" >&2
  return 1
}

rescue=() normal=()
shopt -s nullglob
for f in "$ENTRIES"/*.conf; do
  if grep -q -- '-rescue' <<<"$f"; then rescue+=("$f"); else normal+=("$f"); fi
done
((${#normal[@]} + ${#rescue[@]} > 0)) || { echo "limine-sync: no boot entries found" >&2; exit 1; }

# Newest first by the version field (version sort), rescue last.
sorted=$(for f in "${normal[@]}"; do
  printf '%s\t%s\n' "$(awk '$1=="version"{print $2}' "$f")" "$f"
done | sort -t$'\t' -k1,1 -V -r | cut -f2)

tmp=$(mktemp "$BOOT/limine/.limine.conf.XXXXXX" 2>/dev/null || { mkdir -p "$BOOT/limine" && mktemp "$BOOT/limine/.limine.conf.XXXXXX"; })
trap 'rm -f "$tmp"' EXIT

{
  echo "# Generated by limine-sync from $ENTRIES - do not edit; it is rewritten on every kernel change."
  echo "timeout: $TIMEOUT"
  echo "default_entry: 2" # entry 1 is the expanded Skein group header
  echo
  # Theme: the Tokyo Night theme (lib/limine-theme.conf), installed next to this script by limine-migrate.sh.
  [[ -f $THEME_FILE ]] && { cat "$THEME_FILE"; echo; }
  echo
  echo "/+Skein"
} >"$tmp"

emit() {
  local f=$1 title linux options initrds=() line key rest
  title=$(awk '$1=="title"{sub(/^title[ \t]+/,""); print; exit}' "$f")
  options=$(awk '$1=="options"{sub(/^options[ \t]+/,""); print; exit}' "$f")
  linux=$(awk '$1=="linux"{print $2; exit}' "$f")
  mapfile -t initrds < <(awk '$1=="initrd"{print $2}' "$f")
  [[ -n $title && -n $linux ]] || { echo "limine-sync: skipping malformed entry $f" >&2; return 0; }
  # Build the entry first; skip it (never fail) if a file is missing, e.g. mid-transaction
  # while a kernel is being replaced and its initramfs does not exist yet.
  local block kpath ipath i name comment
  kpath=$(vol_path "$linux") || { echo "limine-sync: skipping $title (kernel missing)" >&2; return 0; }
  if [[ $f == *-rescue* ]]; then name=Rescue comment="Rescue image"; else name="Nobara Linux" comment="Kernel version: $(awk '$1=="version"{print $2; exit}' "$f")"; fi
  block="//$name"$'\n'"    comment: $comment"$'\n'"    protocol: linux"$'\n'"    path: $kpath"$'\n'"    cmdline: $options"$'\n'
  for i in "${initrds[@]}"; do
    ipath=$(vol_path "$i") || { echo "limine-sync: skipping $title (initramfs missing)" >&2; return 0; }
    block+="    module_path: $ipath"$'\n'
  done
  printf '%s\n' "$block" >>"$tmp"
}

while IFS= read -r f; do [[ -n $f ]] && emit "$f"; done <<<"$sorted"
for f in "${rescue[@]}"; do emit "$f"; done

# Nothing bootable right now (mid-transaction): keep the existing menu untouched.
grep -q '^//' "$tmp" || { echo "limine-sync: no complete entries yet; leaving $OUT unchanged" >&2; exit 0; }
chmod 644 "$tmp"
[[ -f $OUT ]] && cp -f "$OUT" "$OUT.bak"
mv -f "$tmp" "$OUT"
trap - EXIT
sync -f "$OUT" 2>/dev/null || sync
echo "limine-sync: wrote $OUT ($(grep -c '^//' "$OUT") entries)"
