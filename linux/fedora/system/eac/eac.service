[Unit]
Description=Update the Easy Anti-Cheat boot entries
Documentation=file:///etc/sysconfig/eac
# Secure Boot and the enrolled MOKs can change between boots
After=local-fs.target
ConditionPathIsDirectory=/boot/loader/entries

[Service]
Type=oneshot
ExecStart=/etc/kernel/install.d/95-eac.install apply-all

[Install]
WantedBy=multi-user.target
