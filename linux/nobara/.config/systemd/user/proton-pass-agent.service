[Unit]
Description=Proton Pass SSH Agent
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

# Same as linux/arch's unit except pass-cli lives in ~/.local/bin here (Proton's
# official installer, no Fedora package exists) instead of /usr/bin (AUR package).
[Service]
# network-online.target means nothing in a user manager, so wait for DNS before logging in.
ExecStartPre=/bin/sh -c 'for i in $(seq 30); do getent hosts proton.me >/dev/null && exit 0; sleep 1; done; exit 0'
ExecStartPre=/bin/sh -c '%h/.local/bin/pass-cli info >/dev/null 2>&1 || %h/.local/bin/pass-cli login --pat "$(cat %h/.config/proton-pass-cli/pat)"'
ExecStart=%h/.local/bin/pass-cli ssh-agent start --create-new-identities SSH --socket-path %h/.ssh/proton-pass-agent.sock
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
