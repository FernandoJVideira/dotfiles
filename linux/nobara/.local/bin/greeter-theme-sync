#!/bin/bash
# Keep the Quickshell login screen (linux/nobara-login) in step with the Omadora theme: its colors, the
# user to log in as, the logo and which monitor gets the form. Run by the theme-set hook on every theme change.
# The greeter directory is handed to your user by `remove-kde.sh greeter`, so this needs no sudo;
# without it (the greeter isn't set up) there is nothing to do.
set -euo pipefail

dir=/usr/local/share/dotfiles-greeter
current="${OMADORA_CONFIG_HOME:-$HOME/.config/omadora}/current"
[[ -d $dir && -O $dir && -w $dir ]] || exit 0

colors="$current/theme/colors.toml"
[[ -f $colors ]] || { echo "greeter-theme-sync: no $colors" >&2; exit 1; }

color() {
  local value
  value=$(sed -n "s/^$1[[:space:]]*=[[:space:]]*\"\(#[0-9a-fA-F]\{6\}\)\".*/\1/p" "$colors" | head -n 1)
  printf '%s' "${value:-$2}"
}

# the block letters of Omadora's logo (its box-drawing frame left out), as a QML string
logo_file="${OMADORA_PATH:-$HOME/.local/share/omadora}/logo.txt"
logo=""
if [[ -f $logo_file ]]; then
  while IFS= read -r line; do
    logo+="${line//\"/}\\n"
  done < <(grep -E '█|▄|▀' "$logo_file" | grep -Ev '└|┌')
  logo="${logo%\\n}"
fi
[[ -n $logo ]] || logo="OMADORA"

# the main monitor: the one the generated block of monitors.lua (lib/monitors.sh) puts at 0x0. That
# file is always there, unlike a running Hyprland, which this may be called without; hyprctl is the fallback.
monitors_lua="$HOME/.config/hypr/monitors.lua"
primary=""
[[ -f $monitors_lua ]] && primary=$(sed -n 's/.*\["\([^"]*\)"\][[:space:]]*=[[:space:]]*"0x0".*/\1/p' "$monitors_lua" | head -n 1)
[[ -n $primary ]] || primary=$(hyprctl -j monitors 2>/dev/null | jq -r '[.[] | select(.x == 0 and .y == 0)][0].name // empty' 2>/dev/null || true)

cat >"$dir/Theme.qml" <<QML
import QtQuick

QtObject {
  readonly property string user: "$USER"
  readonly property string primary: "$primary"
  readonly property string logo: "$logo"
  readonly property color background: "$(color background '#1a1b26')"
  readonly property color foreground: "$(color foreground '#c0caf5')"
  readonly property color accent: "$(color accent '#7aa2f7')"
  readonly property color red: "$(color red '#f7768e')"
}
QML
chmod -R a+rX "$dir"
