[Unit]
Description=Proton Pass SSH Agent
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
# skipped, not failed, until a token is in the keyring or pass-cli is already logged in
ExecCondition=/bin/sh -c 'pass-cli info >/dev/null 2>&1 || secret-tool lookup service proton-pass-cli account pat >/dev/null 2>&1'
# network-online.target means nothing in a user manager, so wait for DNS before logging in.
ExecStartPre=/bin/sh -c 'for i in $(seq 30); do getent hosts proton.me >/dev/null && exit 0; sleep 1; done; exit 0'
ExecStartPre=/bin/sh -c 'pass-cli info >/dev/null 2>&1 || { for i in $$(seq 15); do pat=$$(secret-tool lookup service proton-pass-cli account pat 2>/dev/null) && [ -n "$$pat" ] && break; sleep 1; done; pass-cli login --pat "$$pat"; }'
ExecStart=/usr/bin/pass-cli ssh-agent start --vault-name SSH --create-new-identities SSH --socket-path %h/.ssh/proton-pass-agent.sock
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
