[Unit]
Description=Proton Pass SSH Agent
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5
# Needs a personal access token (a secret this repo cannot ship); without it the unit is skipped instead of failing every login.
ConditionPathExists=%h/.config/proton-pass-cli/pat

[Service]
# the token file is created with a placeholder; until it is replaced the unit is skipped, not failed
ExecCondition=/bin/sh -c '[ -s %h/.config/proton-pass-cli/pat ] && ! grep -Fq REPLACE_WITH_ %h/.config/proton-pass-cli/pat'
# network-online.target means nothing in a user manager, so wait for DNS before logging in.
ExecStartPre=/bin/sh -c 'for i in $(seq 30); do getent hosts proton.me >/dev/null && exit 0; sleep 1; done; exit 0'
ExecStartPre=/bin/sh -c 'pass-cli info >/dev/null 2>&1 || pass-cli login --pat "$(cat %h/.config/proton-pass-cli/pat)"'
ExecStart=/usr/bin/pass-cli ssh-agent start --create-new-identities SSH --socket-path %h/.ssh/proton-pass-agent.sock
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
